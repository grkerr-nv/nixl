# Build this base with contrib/Dockerfile.vllm and fault-injection-enabled wheels.
ARG BASE_IMAGE=nixl-vllm:latest
FROM ${BASE_IMAGE}

# Keep libraries in the wheel so their relative dependency paths remain valid.
RUN python3 - <<'PY'
import ctypes
from pathlib import Path

from nixl import _api

plugin_dir = (
    Path(_api.__file__).resolve().parent.parent
    / f".{_api.__package__}.mesonpy.libs"
    / "plugins"
)
proxy = plugin_dir / "fault_injection/libnixl_fault_proxy.so"
genuine = plugin_dir / "libplugin_UCX.so"
for library in (proxy, genuine):
    if not library.is_file():
        raise RuntimeError(
            f"Missing {library}; rebuild the NIXL wheel with "
            "-Dbuild_fault_injection=true -Denable_plugins=UCX"
        )
    ctypes.CDLL(str(library))

root = Path("/opt/nixl-fault")
root.mkdir(parents=True, exist_ok=True)
# Keep $ORIGIN relative to the original plugin directory, including repaired wheels.
selector = proxy.with_name("libplugin_UCX.so")
selector.unlink(missing_ok=True)
selector.symlink_to(proxy.name)
# One stable NIXL_PLUGIN_DIR, whichever CUDA variant names the wheel's library
# directory. A directory symlink keeps the proxy's $ORIGIN-relative dependencies
# resolvable, because ".." resolves against the link target.
selected = root / "plugins"
selected.unlink(missing_ok=True)
selected.symlink_to(proxy.parent)
(root / "inert.toml").write_text(
    "[fault_injection]\n"
    "schema_version = 1\n"
    'experiment_id = "inert-vllm-ucx"\n'
    f'real_plugin_path = "{genuine}"\n'
    "rules = []\n"
)
PY

# The heredoc above is a BuildKit feature. The legacy builder does not fail on
# it: it runs the RUN line with an empty here-document, silently skips the body,
# and succeeds, leaving NIXL_PLUGIN_DIR below pointing at a directory that was
# never created. Fail at build time rather than at container start.
RUN test -f /opt/nixl-fault/inert.toml \
    && test -e /opt/nixl-fault/plugins/libplugin_UCX.so \
    || { echo "FATAL: the setup step did not run. Build with BuildKit (DOCKER_BUILDKIT=1)." >&2; exit 1; }

# Set in the image, not in an entrypoint wrapper, so every process gets the proxy:
# an overridden entrypoint, a replaced command, and docker exec alike. The base
# image's own entrypoint and arguments are left alone.
ENV NIXL_PLUGIN_DIR=/opt/nixl-fault/plugins \
    NIXL_FAULT_CONFIG_FILE=/opt/nixl-fault/inert.toml \
    NIXL_LOG_LEVEL=INFO
